<file path="app/Http/Controllers/CheckoutController.php">
<?php

namespace App\Http\Controllers;

use App\Models\Transaction;
use App\Models\DetailTransaction;
use App\Models\Item;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\DB;
use Carbon\Carbon;

class CheckoutController extends Controller
{
    public function index()
    {
        $cart = session('cart', []);

        if (empty($cart)) {
            return redirect()->route('cart.index')->with('error', 'Keranjang kamu masih kosong.');
        }

        $items = Item::whereIn('id', array_keys($cart))->get();

        return view('checkout.index', compact('items', 'cart'));
    }

    public function store(Request $request)
    {
        $validated = $request->validate([
            'rent_date' => 'required|date|after_or_equal:today',
            'expected_return_date' => 'required|date|after:rent_date',
        ]);

        $cart = session('cart', []);

        if (empty($cart)) {
            return redirect()->route('cart.index')->with('error', 'Keranjang kamu masih kosong.');
        }

        // Cek stok masih cukup sebelum diproses
        foreach ($cart as $itemId => $data) {
            $item = Item::find($itemId);
            if (!$item || $item->stock < $data['quantity']) {
                return back()->with('error', 'Stok salah satu alat tidak mencukupi. Cek kembali keranjang kamu.');
            }
        }

        $days = max(Carbon::parse($validated['rent_date'])->diffInDays($validated['expected_return_date']), 1);

        $transaction = DB::transaction(function () use ($cart, $validated, $days) {
            $transaction = Transaction::create([
                'user_id' => Auth::id(),
                'rent_date' => $validated['rent_date'],
                'expected_return_date' => $validated['expected_return_date'],
                'price_total' => 0,
                'status' => 'Pending',
            ]);

            $total = 0;

            foreach ($cart as $itemId => $data) {
                $item = Item::findOrFail($itemId);
                $subtotal = $item->price_per_day * $data['quantity'] * $days;
                $total += $subtotal;

                DetailTransaction::create([
                    'transaction_id' => $transaction->id,
                    'item_id' => $item->id,
                    'quantity' => $data['quantity'],
                    'price_per_day' => $item->price_per_day,
                    'subtotal' => $subtotal,
                ]);

                $item->decrement('stock', $data['quantity']);
            }

            $transaction->update(['price_total' => $total]);

            return $transaction;
        });

        session()->forget('cart');

        return redirect()->route('payment.show', $transaction->id)->with('success', 'Transaksi dibuat! Silakan lanjutkan pembayaran.');
    }
}
