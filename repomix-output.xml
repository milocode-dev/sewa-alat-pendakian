<file path="app/Http/Controllers/CartController.php">
<?php

namespace App\Http\Controllers;

use App\Models\Item;
use Illuminate\Http\Request;

class CartController extends Controller
{
    public function add(Request $request, Item $item)
    {
        $request->validate([
            'quantity' => 'required|integer|min:1|max:' . $item->stock,
        ]);

        $cart = session()->get('cart', []);

        if (isset($cart[$item->id])) {
            $cart[$item->id]['quantity'] += $request->quantity;
        } else {
            $cart[$item->id] = ['quantity' => $request->quantity];
        }

        session()->put('cart', $cart);

        return back()->with('success', 'Alat berhasil ditambahkan ke keranjang!');
    }

    public function index()
    {
        $cart = session()->get('cart', []);
        $items = Item::whereIn('id', array_keys($cart))->get();

        $cartItems = $items->map(function ($item) use ($cart) {
            $item->cart_quantity = $cart[$item->id]['quantity'];
            $item->cart_subtotal = $item->price_per_day * $item->cart_quantity;
            return $item;
        });

        $total = $cartItems->sum('cart_subtotal');

        return view('cart.index', compact('cartItems', 'total'));
    }

    public function update(Request $request, Item $item)
    {
        $request->validate([
            'quantity' => 'required|integer|min:1|max:' . $item->stock,
        ]);

        $cart = session()->get('cart', []);
        if (isset($cart[$item->id])) {
            $cart[$item->id]['quantity'] = $request->quantity;
            session()->put('cart', $cart);
        }

        return back()->with('success', 'Keranjang diupdate.');
    }

    public function remove(Item $item)
    {
        $cart = session()->get('cart', []);
        unset($cart[$item->id]);
        session()->put('cart', $cart);

        return back()->with('success', 'Alat dihapus dari keranjang.');
    }
}
